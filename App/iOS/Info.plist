<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The launch screen: the icon's nine-bar mark, still, on the app's own
	     dark panel colour. `App/iOS/LaunchScreen.storyboard`.

	     **A storyboard, not the `UILaunchScreen` dictionary** this used to be
	     (empty, which gave a blank white or black screen). The dictionary can
	     name a colour and an image, and Apple documents nothing about how the
	     image is scaled; developer reports going back to iOS 14 have it drawn
	     at its own size on a first install and stretched to fill the screen on
	     later launches, with no answer from Apple and the storyboard as the
	     only fix anyone confirmed. A storyboard states the size and the centre
	     as constraints, so there is nothing to find out on a customer's phone.

	     **Dark whatever the system is set to.** The frame is drawn before any
	     of our code runs, so it cannot know the app's own theme — and that
	     theme defaults to dark, as the icon is. Following the system would
	     flash white in front of the default look on every light-mode phone.

	     Only one of the two keys may be present; `LaunchScreenTests` holds the
	     storyboard to the palette and to the catalog. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- iPhone: landscape only, and deliberately.

	     A waveform is a horizontal instrument. Portrait on a phone gives a
	     390 pt timeline under a transport bar designed for a thousand, and the
	     honest choice was landscape-only or no iPhone at all. Locking the
	     orientation is allowed on iPhone; the iPadOS 26 rule that an app must
	     be resizable and support every orientation applies to iPad, which the
	     `~ipad` key below still satisfies. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<!-- Files shows this app's own Documents folder, and a track opened from
	     elsewhere opens in place rather than as a copy — so a sidecar written
	     beside it lands beside the *original*. Neither key registers the app as
	     a handler for anything; CFBundleDocumentTypes below does that. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- What makes Artscripture appear in Files ▸ Share ▸ Open With, and in the
	     "Open in…" sheet from Mail, Dropbox and AirDrop. Without it the app can
	     only ever reach a file through its own picker.

	     The same list as the Mac bundle **minus `org.xiph.ogg-audio`**: iOS does
	     not decode Ogg Vorbis (measured 2026-07-30 on an iPad simulator — see
	     `decodesEveryNativeFormat`). Claiming a format we then fail to open
	     would offer the user a route that dead-ends in an error.

	     `Alternate` rather than `Owner`: these are other people's audio files and
	     a transcription tool should not take over as their default handler. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mp3</string>
				<string>public.aac-audio</string>
				<string>com.apple.m4a-audio</string>
				<string>com.apple.protected-mpeg-4-audio-b</string>
				<string>public.mpeg-4-audio</string>
				<string>org.xiph.flac</string>
				<string>com.microsoft.waveform-audio</string>
				<string>public.aiff-audio</string>
				<string>public.aifc-audio</string>
				<string>com.apple.coreaudio-format</string>
			</array>
		</dict>
		<!-- Opened for the soundtrack; the picture is never decoded. Identical to
		     the Mac bundle's video entry, because unlike Ogg all three decode on
		     iOS (VideoSoundtrackTests runs in the iPad simulator bundle). The
		     identifiers match AudioFileTypes.videoContainers, and
		     AudioFileTypesTests fails if they disagree. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.mpeg-4</string>
				<string>com.apple.quicktime-movie</string>
				<string>com.apple.m4v-video</string>
			</array>
		</dict>
	</array>
	<!-- Artscripture uses no encryption of its own, and nothing beyond what the OS
	     does for it. Stating that here means App Store Connect stops asking the
	     export-compliance questionnaire on every single upload; leaving it out
	     is not a rejection, just a manual step repeated forever. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Audio keeps playing when the app is backgrounded or the screen locks.
	     A practice tool that stopped when you looked away from the iPad to your
	     instrument would be useless; this is what `AVAudioSession`'s `.playback`
	     category is declared for in `AVAudioSessionCoordinator`. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
